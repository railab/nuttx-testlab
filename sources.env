# Default NuttX sources tested by nuttx-testlab.
# Override any value with an environment variable of the same name,
# e.g. NUTTX_REPO=https://github.com/me/nuttx NUTTX_REF=my-branch ./repo_init.sh
# A ref can be a branch, a tag or a commit SHA.

NUTTX_REPO="${NUTTX_REPO:-https://github.com/apache/nuttx}"
NUTTX_REF="${NUTTX_REF:-master}"
APPS_REPO="${APPS_REPO:-https://github.com/apache/nuttx-apps}"
APPS_REF="${APPS_REF:-master}"
