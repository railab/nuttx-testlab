#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTLAB_HWTL
	tristate "hwtl: hardware test tool"
	default n
	---help---
		Board device checks: periodic timer, oneshot timer and random
		number generator.  Each check prints one PASS/FAIL verdict line.

if TESTLAB_HWTL

config TESTLAB_HWTL_PROGNAME
	string "Program name"
	default "hwtl"

config TESTLAB_HWTL_PRIORITY
	int "hwtl task priority"
	default 100

config TESTLAB_HWTL_STACKSIZE
	int "hwtl stack size"
	default DEFAULT_TASK_STACKSIZE

endif
