#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTLAB_PTPTL
	tristate "ptptl: PTP daemon test tool"
	default n
	depends on NETUTILS_PTPD
	---help---
		Runs the netutils/ptpd daemon as master or client, prints one
		status line per second and a PASS/FAIL verdict line.

if TESTLAB_PTPTL

config TESTLAB_PTPTL_PROGNAME
	string "Program name"
	default "ptptl"

config TESTLAB_PTPTL_PRIORITY
	int "ptptl task priority"
	default 100

config TESTLAB_PTPTL_STACKSIZE
	int "ptptl stack size"
	default 8192
	---help---
		The status line is printed with 17 arguments; 2048 bytes
		overflow on x86_64.

config TESTLAB_PTPTL_DAEMON_STACKSIZE
	int "ptpd daemon task stack size"
	default 8192

endif
